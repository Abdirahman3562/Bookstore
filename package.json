{
  "name": "bookstore",
  "private": true,
  "version": "0.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:database\" \"npm run dev:backend\" \"npm run dev:front\"",
    "dev:front": "cd front && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:database": "echo 'Starting MongoDB... (Make sure MongoDB is running on port 27017)' && timeout 2",
    "build": "cd front && npm run build",
    "lint": "cd front && npm run lint",
    "preview": "cd front && npm run preview",
    "start": "concurrently \"npm run dev\"",
    "server:books": "json-server --watch front/src/data/books.json --port 5100  --host 0.0.0.0",
    "server:purchased": "json-server --watch front/src/data/purchased.json --port 5001 --host 0.0.0.0",
    "server:user": "json-server --watch front/src/data/users.json --port 5002 --host 0.0.0.0",
    "server:downloads": "json-server --watch front/src/data/downloads.json --port 5003 --host 0.0.0.0",
    "server:Testimonials": "json-server --watch front/src/data/Testimonials.json --port 5004 --host 0.0.0.0",
    "server:authors": "json-server --watch front/src/data/authors.json --port 5005 --host 0.0.0.0",
    "server:blogs": "json-server --watch front/src/data/blogs.json --port 5006 --host 0.0.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "json-server": "^1.0.0-beta.3",
    "lucide-react": "^0.554.0",
    "mongoose": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4"
  }
}
